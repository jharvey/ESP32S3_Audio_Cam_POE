(version 1)

# Test points are bare pads or unpopulated 1.00 mm header pads: nothing is placed on them,
# so their courtyards do not need to clear other parts.
(rule "Test points: no courtyard check"
	(condition "A.Reference == 'TP*' || B.Reference == 'TP*'")
	(constraint courtyard_clearance (min -10mm)))

# RF feeds are 0.38 mm microstrip (50 ohm over the In1 ground plane, 0.21 mm prepreg).
# Keep the ground pour 0.4 mm away so the pour does not pull the impedance down.
# Vias are 0.6 mm with a 0.3 mm drill, no smaller (house rule). Pad holes in footprints are not
# affected (U18's thermal holes are 0.2 mm).
(rule "Vias 0.6/0.3 minimum"
	(condition "A.Type == 'Via'")
	(constraint via_diameter (min 0.6mm))
	(constraint hole_size (min 0.3mm)))

(rule "RF feeds: pour gap"
	(condition "A.Type == 'Zone' && (B.NetName == '/RF1' || B.NetName == '/RF1-ANT' || B.NetName == '/LORA1' || B.NetName == '/LORA1-ANT')")
	(constraint clearance (min 0.4mm)))

# PoE isolation. The Ethernet line side (jack pins, the line side of transformer T1, the bridges D5 and D6, D7, C107,
# the PoE module's input pins and the 75 ohm termination parts) must stay 2.5 mm from all logic-side copper, on every
# layer, so the barrier stands the 1500 V that PoE asks for. Line-side nets may be close to each other, and to the
# jack's shield (/FGND1). The line-side nets are: W_TD_P/N, W_RD_P/N (pairs), W_TXCM, W_RXCM (centre taps), W_VP, W_VN
# (spare pairs), W_BR_P, W_BR_N (bridge outputs), W_TERM, W_TERM2 (termination), W_TAP12, W_TAP13 (T1's spare taps).
# W_TD_OUT_* and W_RD_OUT_* are the logic side of T1 and are not in the rule.
# C68 (1 nF, 2 kV, 1206) is the one part allowed to bridge the barrier, so its own two pads are left out.
(rule "PoE isolation: 2.5 mm from the Ethernet line side to logic"
	(condition "(A.NetName == '/W_?D_?' || A.NetName == '/W_?XCM' || A.NetName == '/W_V?' || A.NetName == '/W_BR_?' || A.NetName == '/W_TERM*' || A.NetName == '/W_TAP*') && !(B.NetName == '/W_?D_?' || B.NetName == '/W_?XCM' || B.NetName == '/W_V?' || B.NetName == '/W_BR_?' || B.NetName == '/W_TERM*' || B.NetName == '/W_TAP*') && B.NetName != '/FGND1' && B.NetName != '' && !(A.memberOfFootprint('C68') && B.memberOfFootprint('C68'))")
	(constraint clearance (min 2.5mm)))

# J21 is the optional LD2410C radar module (do-not-fit). Its courtyard is the whole 22 x 16 mm module, which rides
# 2.5 mm above the board on its pins, so low parts may sit under it. KEEP ANYTHING TALLER THAN 2 mm OUT BY HAND.
(rule "J21 radar module: low parts may sit under it"
	(condition "A.Reference == 'J21' || B.Reference == 'J21'")
	(constraint courtyard_clearance (min -30mm)))
